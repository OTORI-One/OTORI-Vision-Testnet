# OTORI Vision Token (OVT) Configuration

# Program ID for the deployed contract
# Replace with your actual program ID after deployment
NEXT_PUBLIC_PROGRAM_ID=your_program_id_here

# Treasury address for the deployed contract
# Replace with your actual treasury address after deployment
NEXT_PUBLIC_TREASURY_ADDRESS=your_treasury_address_here

# Hybrid Mode Configuration
# Set to 'false' to use only real data, 'true' for mock mode, or 'hybrid' for hybrid mode
NEXT_PUBLIC_MOCK_MODE=hybrid

# Granular toggles for hybrid mode (only used when NEXT_PUBLIC_MOCK_MODE=hybrid)
# Set to 'mock' to use mock data or 'real' to use real contract data
NEXT_PUBLIC_PORTFOLIO_DATA_SOURCE=mock
NEXT_PUBLIC_TRANSACTION_DATA_SOURCE=real
NEXT_PUBLIC_TOKEN_SUPPLY_DATA_SOURCE=real

# Arch Network Configuration
# Update with your Arch Network endpoint
NEXT_PUBLIC_ARCH_ENDPOINT=http://localhost:9002

# Bitcoin Price API Configuration (optional)
# If not provided, a default API will be used
# NEXT_PUBLIC_BITCOIN_PRICE_API=https://api.example.com/bitcoin/price

# Development settings
NODE_ENV=development
NEXT_PUBLIC_LOCAL_VALIDATOR_URL=http://localhost:8899
NEXT_PUBLIC_ELECTRS_URL=http://localhost:3002
NEXT_PUBLIC_BITCOIN_RPC_URL=http://localhost:18443
NEXT_PUBLIC_BITCOIN_RPC_USER=bitcoin
NEXT_PUBLIC_BITCOIN_RPC_PASS=bitcoinpass

# Feature flags
NEXT_PUBLIC_ENABLE_LOGGING=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true 