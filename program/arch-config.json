{
  "name": "OTORI Vision Token",
  "version": "1.0.0",
  "description": "On-chain VC fund on Bitcoin built on Arch Network",
  "program": {
    "id": "ovt1111111111111111111111111111111111111111",
    "entrypoint": "program/src/arch_program.rs",
    "accounts": [
      {
        "name": "state",
        "type": "OVTState",
        "seed": "ovt_state",
        "size": 256
      },
      {
        "name": "treasury",
        "type": "TreasuryAccount",
        "seed": "treasury",
        "size": 128
      }
    ]
  },
  "network": {
    "testnet": {
      "endpoint": "https://api.testnet.archnetwork.io",
      "bitcoin_network": "testnet4",
      "bitcoin_rpc": "http://localhost:18332",
      "electrs_endpoint": "http://localhost:50001"
    }
  },
  "build": {
    "target": "wasm32-unknown-unknown",
    "features": ["testnet"],
    "debug": true
  },
  "test": {
    "bitcoin_regtest": true,
    "mock_bitcoin_rpc": false,
    "coverage": true
  },
  "security": {
    "multisig_threshold": 3,
    "multisig_total": 5,
    "admin_pubkeys": []
  },
  "monitoring": {
    "log_level": "info",
    "metrics_enabled": true,
    "error_reporting": true
  }
} 